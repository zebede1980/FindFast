<UserControl x:Class="FastFind.App.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FastFind.App.Views"
             xmlns:vm="clr-namespace:FastFind.App.ViewModels"
             Focusable="False" AllowDrop="True">
    <!-- A pane is a sheet of glass. The margin is half the gap between it and its neighbours. -->
    <Grid Margin="4,0,4,4">
        <Border CornerRadius="12" BorderThickness="1" Background="{DynamicResource FrostPaneBrush}" BorderBrush="{DynamicResource FrostCardStrokeBrush}" />
        <!-- Marks the pane that keyboard commands act on: its edge lights up in the accent colour and glows, like a lit
             tube round the glass. With one pane there is nothing to tell apart, so it stays off. It is an outline with
             nothing inside it, so the glow (an effect, which softens whatever it is applied to) never touches the text. -->
        <Border x:Name="ActiveMarker" CornerRadius="12" BorderThickness="1.5" IsHitTestVisible="False"
                BorderBrush="{DynamicResource FrostActiveStrokeBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.9" Color="{DynamicResource FrostAccentColor}" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="True" />
                                <Condition Binding="{Binding Main.IsDualPane}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <TabControl x:Name="Tabs" Style="{StaticResource SearchTabControl}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                    PreviewMouseDown="OnTabsPreviewMouseDown">
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:FileTabViewModel}">
                    <views:FilePaneView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <!-- The new-tab button follows the last tab. The tab control's template leaves room for it (see SearchTabControl). -->
        <StackPanel x:Name="StripButtons" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"
                    SizeChanged="OnStripButtonsSizeChanged">
            <Button x:Name="NewTabButton" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0" FontSize="12" Content="&#xE710;" ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab"
                    Command="{Binding NewTabCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
