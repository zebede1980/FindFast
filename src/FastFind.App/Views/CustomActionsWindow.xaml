<Window x:Class="FastFind.App.Views.CustomActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Right-click actions" Width="900" Height="760" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Your own entries for the right-click menu of files and folders. Each one starts a program with what you have selected, and is offered only when everything selected is something it applies to." />

        <DockPanel Grid.Row="1" Margin="0,0,18,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AddButton" Content="Add  ▾" Padding="10,4" Click="OnAddClick" ToolTip="Make a new action">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Empty action" Click="OnAddEmptyClick" />
                            <MenuItem Header="Run a PowerShell script" Click="OnAddPowerShellClick" />
                            <MenuItem Header="Open with a program…" Click="OnAddProgramClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RemoveButton" Content="Remove" Padding="10,4" Margin="6,0,0,0" Click="OnRemoveClick" />
                <Button x:Name="UpButton" Style="{StaticResource IconButton}" Content="&#xE70E;" Margin="8,0,0,0" Click="OnUpClick"
                        ToolTip="Move up the menu" AutomationProperties.Name="Move up" />
                <Button x:Name="DownButton" Style="{StaticResource IconButton}" Content="&#xE70D;" Click="OnDownClick"
                        ToolTip="Move down the menu" AutomationProperties.Name="Move down" />
            </StackPanel>
            <ListBox x:Name="ActionList" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Actions">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxWidth="360"
                   Text="No actions yet. Choose Add to make one: for instance to run a PowerShell script, or to hand video files to a program of your choice." />

        <ScrollViewer x:Name="FormScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <!-- The right margin keeps the boxes clear of the scroll bar when the window is short enough to need one -->
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource L}" Text="NAME IN THE MENU" Margin="0,0,0,3" />
                <TextBox x:Name="NameBox" TextChanged="OnFieldChanged" AutomationProperties.Name="Name in the menu" />

                <TextBlock Style="{StaticResource L}" Text="OFFER IT FOR" />
                <TextBox x:Name="AppliesBox" TextChanged="OnFieldChanged" AutomationProperties.Name="Offer it for" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="File extensions separated by semicolons (ps1; psm1), a kind of file (video, audio, images, documents, archives, code, executables), folder, or * for any file. Mix them freely." />

                <TextBlock Style="{StaticResource L}" Text="PROGRAM" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,4" Margin="6,0,0,0" Click="OnBrowseClick" />
                    <TextBox x:Name="ProgramBox" TextChanged="OnFieldChanged" AutomationProperties.Name="Program" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="A full path, or a name Windows can find by itself, such as pwsh.exe or notepad.exe." />

                <TextBlock Style="{StaticResource L}" Text="ARGUMENTS" />
                <TextBox x:Name="ArgumentsBox" TextChanged="OnFieldChanged" AutomationProperties.Name="Arguments" FontFamily="Cascadia Mono, Consolas" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="{}{path} is the item, {folder} the folder it is in, {name} its name and {basename} its name without the extension. {paths} is everything selected, handed over in one go; leaving this empty does the same. Paths with spaces are quoted for you." />

                <TextBlock Style="{StaticResource L}" Text="START IN" />
                <TextBox x:Name="StartInBox" TextChanged="OnFieldChanged" AutomationProperties.Name="Start in" />
                <TextBlock Style="{StaticResource Hint}" Text="The program's working folder. Leave empty for the folder the item is in." />

                <CheckBox x:Name="AdminBox" Content="Run as administrator" Margin="0,14,0,0" Checked="OnFieldChanged" Unchecked="OnFieldChanged"
                          ToolTip="Windows asks for permission each time. FastFind itself carries on without administrator rights." />

                <Border CornerRadius="8" Padding="14,10" Margin="0,16,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="PreviewCaption" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PreviewText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock x:Name="PreviewNote" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" Click="OnCloseClick" IsCancel="True" />
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Changes are saved as you make them." />
        </DockPanel>
    </Grid>
</Window>
