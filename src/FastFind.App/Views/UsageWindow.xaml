<Window x:Class="FastFind.App.Views.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:map="clr-namespace:FastFind.App.Treemap"
        Title="Disk usage" Width="1280" Height="860" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- Selection is a tint of the accent colour, as in the file panes, so text keeps its normal colour. -->
        <Style x:Key="UsageCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NumberText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="FaintNumberText" TargetType="TextBlock" BasedOn="{StaticResource NumberText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="UsageGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CellStyle" Value="{StaticResource UsageCell}" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>
        <!-- The chevron that opens and closes a folder in the tree -->
        <Style x:Key="Expander" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One kind of file in the legend: click to pick that kind out on the map -->
        <Style x:Key="KindChip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="8,3,9,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="11" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="UpperRow" Height="2*" MinHeight="110" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: what is being measured and what it came to -->
        <Grid Margin="16,12,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEB05;" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SummaryText" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="LabelsToggle" Style="{StaticResource PillToggle}" Height="30" Click="OnLabelsClick" AutomationProperties.Name="Folder names on the map"
                              ToolTip="Show the names of the biggest folders on the map">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8EC;" FontSize="13" VerticalAlignment="Center" Margin="0,1,6,0" />
                        <TextBlock Text="Names" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Click="OnRefreshClick"
                        ToolTip="Measure again (F5)" AutomationProperties.Name="Measure again" />
            </StackPanel>
        </Grid>

        <!-- Body: the folder tree above the map on the left; on the right, at full height, the file types, applications and clean-up lists -->
        <Grid Grid.Row="1" Grid.RowSpan="3" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TypesColumn" Width="430" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="110" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="160" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="Tree" Style="{StaticResource UsageGrid}" AutomationProperties.Name="Folders and files by size"
                      SelectionChanged="OnTreeSelectionChanged" PreviewKeyDown="OnTreeKeyDown" MouseDoubleClick="OnTreeDoubleClick"
                      ContextMenuOpening="OnTreeContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="TreeMenu" />
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                    <Button Style="{StaticResource Expander}" Content="{Binding ExpanderGlyph}" Click="OnExpanderClick" AutomationProperties.Name="Open or close folder"
                                            Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Width="20" Visibility="{Binding CanExpand, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="3,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" />
                                    <Ellipse Width="8" Height="8" Margin="8,1,0,0" VerticalAlignment="Center" Fill="{Binding Swatch}"
                                             Visibility="{Binding Swatch, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Share of folder" Width="150" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="2,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="6" CornerRadius="3" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" Opacity="0.45" />
                                    <Border Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="96" ElementStyle="{StaticResource NumberText}" />
                    <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" Width="84" ElementStyle="{StaticResource FaintNumberText}" />
                    <DataGridTextColumn Header="Date modified" Binding="{Binding Modified, Converter={StaticResource DateTimeConverter}}" Width="128" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="9" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Right-hand panel: three ways of looking at the same space -->
            <Grid Grid.Column="2" Grid.RowSpan="3" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="1,0,0,6">
                <RadioButton x:Name="TypesTab" Style="{StaticResource PillToggle}" Height="28" Margin="0" GroupName="UsagePanel" IsChecked="True" Checked="OnPanelTabChecked"
                             Content="File types" FontSize="12" ToolTip="Which types of file take the most room" />
                <RadioButton x:Name="AppsTab" Style="{StaticResource PillToggle}" Height="28" GroupName="UsagePanel" Checked="OnPanelTabChecked"
                             Content="Applications" FontSize="12" ToolTip="How much each application takes: its program, data, caches and logs, wherever they are kept" />
                <RadioButton x:Name="CleanupTab" Style="{StaticResource PillToggle}" Height="28" GroupName="UsagePanel" Checked="OnPanelTabChecked"
                             FontSize="12" ToolTip="What could be removed to free space">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Clean up" VerticalAlignment="Center" />
                        <TextBlock x:Name="CleanupBadge" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Normal" Opacity="0.85" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Applications -->
            <Grid x:Name="AppsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="4,2,4,6">
                    <TextBlock x:Name="AppsSummary" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="9" />
                                <Setter Property="Height" Value="9" />
                                <Setter Property="CornerRadius" Value="2" />
                                <Setter Property="Margin" Value="0,1,5,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Style>
                        </StackPanel.Resources>
                        <Border Background="#3987E5" /><TextBlock Text="program" />
                        <Border Background="#9085E9" /><TextBlock Text="data" />
                        <Border Background="#D95926" /><TextBlock Text="caches" />
                        <Border Background="#7C828C" /><TextBlock Text="logs" />
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="Apps" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnAppSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Applications by size" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4,2,4" ToolTip="{Binding ToolTip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <!-- One bar, as long as this application's share of the biggest, split by what the space is for -->
                                    <StackPanel Orientation="Horizontal" Height="5" Margin="0,4,0,3">
                                        <Border Width="{Binding ProgramWidth}" Background="#3987E5" CornerRadius="2" Margin="0,0,1,0" />
                                        <Border Width="{Binding DataWidth}" Background="#9085E9" CornerRadius="2" Margin="0,0,1,0" />
                                        <Border Width="{Binding CacheWidth}" Background="#D95926" CornerRadius="2" Margin="0,0,1,0" />
                                        <Border Width="{Binding LogWidth}" Background="#7C828C" CornerRadius="2" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ClearText}" Click="OnAppClearClick" Padding="9,3" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                        ToolTip="Empty this application's cache folders. Nothing is lost: it makes them again as it needs them."
                                        Visibility="{Binding CanClear, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="AppsEmpty" Grid.Row="1" Visibility="Collapsed" Margin="16" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="No application folders in here. Measure a whole drive (or your user folder) to see what each application takes." />
            </Grid>

            <!-- Clean up -->
            <Grid x:Name="CleanupPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CleanupSummary" Margin="4,2,4,6" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="Cleanup" Focusable="False" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="11" FontWeight="SemiBold" Margin="4,10,0,5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding Heading, Converter={StaticResource NullToVisibility}}" />
                                    <Border CornerRadius="8" Padding="11,8,11,9" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonUp="OnCleanupCardClick"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            ToolTip="Click to pick these out on the map">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Command}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,5,0,0"
                                                       Visibility="{Binding Command, Converter={StaticResource NullToVisibility}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="{Binding ActionText}" Click="OnCleanupActionClick" Padding="11,4" FontSize="12">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="CleanupEmpty" Grid.Row="1" Visibility="Collapsed" Margin="16" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Nothing obvious to remove in here. Measure a whole drive to include temporary files, application caches and Windows' own leftovers." />
            </Grid>

            <DataGrid x:Name="Types" Grid.Row="1" Style="{StaticResource UsageGrid}" AutomationProperties.Name="File types by size"
                      SelectionChanged="OnTypeSelectionChanged" PreviewMouseLeftButtonDown="OnTypesMouseDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="File type" Width="*" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Swatch}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding Extension}" Style="{StaticResource CellText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="92">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" ElementStyle="{StaticResource NumberText}" />
                    <DataGridTextColumn Header="Files" Binding="{Binding FilesText}" Width="70" ElementStyle="{StaticResource FaintNumberText}" />
                </DataGrid.Columns>
            </DataGrid>
            </Grid>

        <GridSplitter Grid.Row="1" Height="9" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Background="Transparent"
                      ToolTip="Drag to give the list or the map more room">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Under the tree: the map -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4" MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- What kinds of file the space on show goes to, and which colour each kind is on the map -->
                <ItemsControl x:Name="Legend" Grid.Column="1" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Right" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource KindChip}" IsChecked="{Binding IsPicked, Mode=OneWay}" Click="OnKindClick" ToolTip="{Binding ToolTip}"
                                          AutomationProperties.Name="{Binding Name}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Swatch}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Where the map is zoomed to -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE74A;" Margin="0,0,4,0" Click="OnZoomOutClick" IsEnabled="False"
                            ToolTip="Zoom out to the folder above (Backspace)" AutomationProperties.Name="Zoom out" />
                    <ItemsControl x:Name="Crumbs" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}" Tag="{Binding Node}" Click="OnCrumbClick" ToolTip="Show this folder on the map" />
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="8" VerticalAlignment="Center" Margin="1,1,1,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding HasNext, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ZoomSizeText" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- The same split as one bar: each kind's share of the space on show -->
            <Grid x:Name="KindBar" Grid.Row="1" Height="8" Margin="0,0,0,7" />

            <!-- The map is drawn on its own dark surface in both themes: the colours are chosen for it -->
            <Border x:Name="MapHost" Grid.Row="2" CornerRadius="9" Background="#0F1114" SizeChanged="OnMapHostSizeChanged">
                <Grid x:Name="MapClip">
                    <map:TreemapView x:Name="Map" MouseLeftButtonDown="OnMapMouseDown" MouseWheel="OnMapMouseWheel" ContextMenuOpening="OnMapContextMenuOpening">
                        <map:TreemapView.ContextMenu>
                            <ContextMenu x:Name="MapMenu" />
                        </map:TreemapView.ContextMenu>
                    </map:TreemapView>
                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                        <Border x:Name="HoverCard" Visibility="Collapsed" CornerRadius="8" Padding="11,8,12,9" Background="#F21B1D22" BorderBrush="#40FFFFFF" BorderThickness="1" MaxWidth="460">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="HoverSwatch" Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center" Margin="0,1,7,0" />
                                    <TextBlock x:Name="HoverName" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock x:Name="HoverPath" FontSize="11.5" Foreground="#B8FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock x:Name="HoverDetail" FontSize="12" Foreground="#E6FFFFFF" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                    <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" IsHitTestVisible="False">
                        <TextBlock x:Name="LoadingText" FontSize="14" Foreground="#E6FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <ProgressBar x:Name="LoadingBar" Height="4" Margin="0,12,0,0" IsIndeterminate="True" Minimum="0" Maximum="1" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!-- Status: what the mouse is over, and what is selected -->
        <Border Grid.Row="4" Padding="16,5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock x:Name="SelectionText" DockPanel.Dock="Right" FontSize="12" Margin="16,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Click the map to find a file in the list  ·  click again to step out to its folder  ·  double-click or scroll to zoom  ·  right-click for more" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
