<Window x:Class="FastFind.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings and index" Width="900" Height="760" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
    </Window.Resources>
    <Grid Margin="22,8,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource H}" Text="Appearance and behaviour" Margin="0,6,0,8" />
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="ThemeBox" Width="140" SelectionChanged="OnThemeChanged">
                <ComboBoxItem Content="Follow Windows" Tag="System" />
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
            </ComboBox>
            <CheckBox x:Name="FolderSizesBox" Content="Show folder sizes" Margin="24,0,0,0" VerticalAlignment="Center" Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      ToolTip="Fill the Size column for folders with the total size of everything inside them, taken from the index" />
            <CheckBox x:Name="HideHiddenBox" Content="Hide hidden &amp; system items in new tabs" Margin="16,0,0,0" VerticalAlignment="Center" Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      ToolTip="Ctrl+H switches this for the current tab" />
            <CheckBox x:Name="ConfirmRecycleBox" Content="Ask before recycling" Margin="16,0,0,0" VerticalAlignment="Center" Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      ToolTip="Confirm before sending items to the Recycle Bin. Permanent deletion (Shift+Del) always asks." />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Global hotkey" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="HotkeyBox" Width="140" ToolTip="e.g. Ctrl+Alt+F, Win+Space, Ctrl+Shift+F12. Leave empty to disable." LostFocus="OnHotkeyChanged" KeyDown="OnHotkeyKeyDown" />
            <TextBlock x:Name="HotkeyError" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <CheckBox x:Name="TrayBox" Content="Keep running in the tray when closed" Margin="24,0,0,0" VerticalAlignment="Center" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
            <CheckBox x:Name="SingleInstanceBox" Content="Single instance" Margin="16,0,0,0" VerticalAlignment="Center" Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      ToolTip="Launching FastFind again brings the running window forward instead of starting a second copy" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="ExplorerMenuBox" Content="Add &quot;Open in FastFind&quot; to the right-click menu of folders and drives in Windows" VerticalAlignment="Center"
                      Checked="OnExplorerMenuChanged" Unchecked="OnExplorerMenuChanged"
                      ToolTip="Registers a menu entry for your account only (no administrator rights needed). Untick to remove it." />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Style="{StaticResource H}" Text="Index" />
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="ServiceButton" DockPanel.Dock="Right" Padding="12,5" Margin="12,0,0,0" VerticalAlignment="Top" Click="OnServiceClick" />
                <TextBlock x:Name="ElevationText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="RemovableBox" Content="Index removable drives (USB)" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                <CheckBox x:Name="NetworkBox" Content="Index mapped network drives (slow)" Margin="20,0,0,0" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
            </StackPanel>
            <TextBlock Text="Network locations (scanned on a schedule, served from cache in between)" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,4" />
            <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="Rescan every" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="RescanHoursBox" Width="44" LostFocus="OnRescanHoursChanged" />
                    <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <Button Content="Rescan now" Margin="12,0,0,0" Padding="10,4" Click="OnRescanNetworkClick" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NetworkPathBox" Width="300" ToolTip="UNC path such as \\server\share or a mapped drive root such as Z:\" KeyDown="OnNetworkPathKeyDown" />
                        <Button Content="Add" Margin="6,0,0,0" Padding="10,4" Click="OnAddNetworkClick" />
                        <Button Content="Remove" Margin="6,0,0,0" Padding="10,4" Click="OnRemoveNetworkClick" />
                    </StackPanel>
                    <ListBox x:Name="NetworkList" MaxHeight="80" Margin="0,4,0,0" Width="420" HorizontalAlignment="Left" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <DataGrid x:Name="VolumeGrid" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="None" SelectionMode="Single" RowHeight="30" FontSize="13" BorderThickness="0" Background="Transparent">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Drive" Binding="{Binding Root}" Width="90" />
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="120" />
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                <DataGridTextColumn Header="Items" Binding="{Binding Entries, StringFormat=N0}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Method" Binding="{Binding Mode}" Width="110" />
                <DataGridTextColumn Header="Build" Binding="{Binding BuildTime, StringFormat=mm\\:ss}" Width="60" />
                <DataGridTextColumn Header="Next scan" Binding="{Binding NextScanUtc, Converter={StaticResource LocalTimeConverter}}" Width="110" />
                <DataGridTextColumn Header="Detail" Binding="{Binding ProgressText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="6" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" Click="OnCloseClick" IsDefault="True" IsCancel="True" />
            <Button DockPanel.Dock="Left" Content="Rebuild all indexes" Padding="10,4" Click="OnRebuildClick" />
            <Button DockPanel.Dock="Left" Content="Rebuild selected" Margin="8,0,0,0" Padding="10,4" Click="OnRebuildSelectedClick" />
            <TextBlock x:Name="LogPathText" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </DockPanel>
    </Grid>
</Window>
