<UserControl x:Class="FastFind.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Border Margin="0,8,10,6" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Placeholder" Grid.RowSpan="4" Text="Select a file to preview it" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <Border x:Name="ImageHost" Grid.Row="0" MaxHeight="280" MinHeight="96" Margin="0,2,0,10" Visibility="Collapsed">
                <Image x:Name="Thumb" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <TextBlock x:Name="NameText" Grid.Row="1" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <Grid x:Name="Details" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Labels" Margin="0,0,14,0" />
                <StackPanel x:Name="Values" Grid.Column="1" />
            </Grid>

            <Border x:Name="TextHost" Grid.Row="3" Margin="0,12,0,0" CornerRadius="6" Padding="8,6" Visibility="Collapsed"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
                    <TextBlock x:Name="TextPreview" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
