<UserControl x:Class="FastFind.App.Views.FilePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FastFind.App.ViewModels"
             xmlns:ctl="clr-namespace:FastFind.App.Controls"
             AllowDrop="True" Focusable="False">
    <Grid Margin="10,8,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation: back / forward / up, then the address bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="-2,0,4,0">
                <Button Style="{StaticResource IconButton}" x:Name="BackButton" Content="&#xE72B;" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back" Click="OnBackClick" IsEnabled="{Binding CanGoBack}" />
                <Button Style="{StaticResource IconButton}" x:Name="ForwardButton" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward" Click="OnForwardClick" IsEnabled="{Binding CanGoForward}" />
                <Button Style="{StaticResource IconButton}" x:Name="UpButton" Content="&#xE74A;" ToolTip="Up to the containing folder (Alt+Up or Backspace)" AutomationProperties.Name="Up" Click="OnUpClick" IsEnabled="{Binding CanGoUp}" />
            </StackPanel>

            <Border x:Name="AddressBorder" Grid.Column="1" CornerRadius="8" Height="34" BorderThickness="1" Cursor="IBeam"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" MouseLeftButtonDown="OnAddressBarMouseDown"
                    ToolTip="Click to type a path (Ctrl+L)">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AddressBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0" Visibility="{Binding IsEverywhere, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Everywhere" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="  all indexed drives" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}" Tag="{Binding Path}" Click="OnCrumbClick"
                                                    ToolTip="{Binding Path}" AllowDrop="True" DragOver="OnCrumbDragOver" Drop="OnCrumbDrop" />
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="8" VerticalAlignment="Center" Margin="1,1,1,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBox x:Name="AddressBox" AutomationProperties.Name="Address" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="10,0" FontSize="13"
                             VerticalContentAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}" KeyDown="OnAddressBoxKeyDown" LostKeyboardFocus="OnAddressBoxLostFocus">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh (Ctrl+R, or F5 when nothing is selected)" AutomationProperties.Name="Refresh" Click="OnRefreshClick" Margin="4,0,-2,0" />
        </Grid>

        <!-- Filter / search box -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Border x:Name="SearchBorder" CornerRadius="8" Height="34" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13" Margin="12,0,9,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" AutomationProperties.Name="Filter or search" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14"
                             VerticalContentAlignment="Center" VerticalAlignment="Stretch" CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnSearchBoxKeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock Grid.Column="1" Text="{Binding SearchPlaceholder}" FontSize="13" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressBar Grid.Column="2" Width="36" Height="3" Margin="8,0" IsIndeterminate="True" VerticalAlignment="Center"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE894;" FontSize="10" Width="26" Height="26" Margin="0,0,5,0"
                            ToolTip="Clear (Esc)" Click="OnClearClick" AutomationProperties.Name="Clear filter"
                            Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Command bar: the everyday file actions on the left, view options on the right -->
        <DockPanel Grid.Row="2" Margin="-3,5,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton x:Name="LockToggle" Style="{StaticResource PillToggle}" Height="30" IsChecked="{Binding IsLocked}" AutomationProperties.Name="Lock tab"
                              ToolTip="Lock this tab: folders you open from it open in the other pane, so you keep your place here (Ctrl+Shift+L)">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="13" />
                </ToggleButton>
                <ToggleButton x:Name="SubfoldersToggle" Style="{StaticResource PillToggle}" Height="30" IsChecked="{Binding Recursive}" AutomationProperties.Name="Include subfolders"
                              ToolTip="Include subfolders: show this folder and everything beneath it as one list (Ctrl+Shift+R)"
                              Visibility="{Binding IsEverywhere, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13" VerticalAlignment="Center" Margin="0,1,6,0" />
                        <TextBlock Text="Subfolders" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FiltersToggle" Style="{StaticResource PillToggle}" Height="30" IsChecked="{Binding FiltersVisible}" ToolTip="Filters and match options"
                              AutomationProperties.Name="Filters">
                    <Grid>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71C;" FontSize="13" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SystemFillColorAttentionBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0"
                                 Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </ToggleButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Width" Value="30" />
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Margin" Value="1,0" />
                    </Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Height" Value="16" />
                        <Setter Property="Margin" Value="5,0" />
                        <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="NewFolderButton" Content="&#xE8F4;" ToolTip="New folder (Ctrl+Shift+N or F7)" AutomationProperties.Name="New folder" Click="OnNewFolderClick" IsEnabled="{Binding CanCreate}" />
                <Button x:Name="NewFileButton" Content="&#xE7C3;" ToolTip="New file (Ctrl+N)" AutomationProperties.Name="New file" Click="OnNewFileClick" IsEnabled="{Binding CanCreate}" />
                <Rectangle />
                <Button x:Name="CutButton" Content="&#xE8C6;" ToolTip="Cut (Ctrl+X)" AutomationProperties.Name="Cut" Click="OnCutClick" IsEnabled="{Binding HasSelection}" />
                <Button x:Name="CopyButton" Content="&#xE8C8;" ToolTip="Copy (Ctrl+C)" AutomationProperties.Name="Copy" Click="OnCopyClick" IsEnabled="{Binding HasSelection}" />
                <Button x:Name="PasteButton" Content="&#xE77F;" ToolTip="Paste into this folder (Ctrl+V)" AutomationProperties.Name="Paste" Click="OnPasteClick" IsEnabled="{Binding CanPaste}" />
                <Rectangle />
                <Button x:Name="RenameButton" Content="&#xE8AC;" ToolTip="Rename (F2); with several items selected, opens the bulk renamer" AutomationProperties.Name="Rename" Click="OnRenameClick" IsEnabled="{Binding HasSelection}" />
                <Button x:Name="DeleteButton" Content="&#xE74D;" ToolTip="Delete to the Recycle Bin (Del); Shift+Del deletes permanently" AutomationProperties.Name="Delete" Click="OnDeleteClick" IsEnabled="{Binding HasSelection}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsDualPane, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle />
                    <Button x:Name="CopyAcrossButton" Width="40" ToolTip="Copy to the folder in the other pane (F5)" AutomationProperties.Name="Copy to other pane" Click="OnCopyAcrossClick" IsEnabled="{Binding HasSelection}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="&#xE72A;" FontSize="10" VerticalAlignment="Center" Margin="3,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoveAcrossButton" Width="40" ToolTip="Move to the folder in the other pane (F6)" AutomationProperties.Name="Move to other pane" Click="OnMoveAcrossClick" IsEnabled="{Binding HasSelection}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontSize="14" />
                            <TextBlock Text="&#xE72A;" FontSize="10" VerticalAlignment="Center" Margin="3,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Filter panel -->
        <Border Grid.Row="3" Margin="0,6,0,0" CornerRadius="8" Padding="12,8,12,6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding FiltersVisible, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel>
                <StackPanel Style="{StaticResource FilterGroup}">
                    <TextBlock Style="{StaticResource FilterLabel}" Text="MATCH" />
                    <StackPanel Orientation="Horizontal" Margin="-3,0,0,0">
                        <ToggleButton Style="{StaticResource PillToggle}" Content="Aa" IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                        <ToggleButton Style="{StaticResource PillToggle}" Content=".*" IsChecked="{Binding UseRegex}" ToolTip="Regular expressions" FontFamily="Consolas" />
                        <ToggleButton Style="{StaticResource PillToggle}" Content="W" IsChecked="{Binding WholeWord}" ToolTip="Whole word" />
                        <ToggleButton Style="{StaticResource PillToggle}" Content="Path" IsChecked="{Binding MatchPath}" ToolTip="Match against the full path" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource FilterGroup}">
                    <TextBlock Style="{StaticResource FilterLabel}" Text="TYPE" />
                    <ComboBox Width="110" ItemsSource="{x:Static vm:FileTabViewModel.TypeChoices}" SelectedItem="{Binding TypeFilter}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FilterGroup}">
                    <TextBlock Style="{StaticResource FilterLabel}" Text="KIND" />
                    <ComboBox Width="120" ItemsSource="{x:Static vm:FileTabViewModel.KindChoices}" SelectedItem="{Binding KindFilter}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FilterGroup}">
                    <TextBlock Style="{StaticResource FilterLabel}" Text="EXTENSIONS" />
                    <TextBox Width="130" Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="e.g. cs;json;md" />
                </StackPanel>
                <StackPanel Style="{StaticResource FilterGroup}">
                    <TextBlock Style="{StaticResource FilterLabel}" Text="SIZE" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="68" Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Minimum, e.g. 10mb" />
                        <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" />
                        <TextBox Width="68" Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Maximum, e.g. 1gb" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource FilterGroup}">
                    <TextBlock Style="{StaticResource FilterLabel}" Text="MODIFIED" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="130" ItemsSource="{x:Static vm:FileTabViewModel.DateChoices}" SelectedItem="{Binding DateFilter}" />
                        <DatePicker Width="130" Margin="6,0,0,0" SelectedDate="{Binding DateFrom}" Visibility="{Binding IsCustomDate, Converter={StaticResource BoolToVisibility}}" />
                        <DatePicker Width="130" Margin="6,0,0,0" SelectedDate="{Binding DateTo}" Visibility="{Binding IsCustomDate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource FilterGroup}" VerticalAlignment="Bottom">
                    <CheckBox Content="Hide hidden &amp; system (Ctrl+H)" IsChecked="{Binding HideHiddenSystem}" Margin="0,0,0,2" />
                </StackPanel>
                <StackPanel Style="{StaticResource FilterGroup}" VerticalAlignment="Bottom">
                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Padding="10,4" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Files -->
        <Grid Grid.Row="4" Margin="0,5,0,0">
            <DataGrid x:Name="Grid" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="28" SelectionMode="Extended" SelectionUnit="FullRow"
                      EnableRowVirtualization="True" EnableColumnVirtualization="False"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="False"
                      Background="Transparent" BorderThickness="0" FontSize="13" AllowDrop="True"
                      Sorting="OnSorting" MouseDoubleClick="OnRowDoubleClick" PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="OnGridPreviewMouseLeftButtonUp" PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                      MouseMove="OnGridMouseMove" PreviewKeyDown="OnGridPreviewKeyDown" PreviewMouseDown="OnGridPreviewMouseDown"
                      ContextMenuOpening="OnContextMenuOpening" SelectionChanged="OnSelectionChanged"
                      DragOver="OnGridDragOver" DragLeave="OnGridDragLeave" Drop="OnGridDrop">
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="RowMenu" />
                </DataGrid.ContextMenu>
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Opacity" Value="{Binding IsHidden, Converter={StaticResource HiddenOpacity}}" />
                    </Style>
                    <!-- Selection is painted by the cells (that is where the theme paints it): a tint of the accent colour instead of
                         the theme's solid accent, so the text keeps its normal colour and stays easy to read. -->
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="CellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                    <!-- The path behaves like a link: hand cursor + underline on hover, double-click to go there -->
                    <Style x:Key="LinkText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="2.2*" SortMemberPath="Name" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ctl:HighlightTextBlock SourceText="{Binding Name}" Style="{StaticResource CellText}"
                                                            HighlightBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                            Highlighter="{Binding DataContext.NameHighlighter, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="PathColumn" Header="Path" Width="3*" SortMemberPath="Path" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ctl:HighlightTextBlock SourceText="{Binding Directory}" Style="{StaticResource LinkText}" ToolTip="Double-click to open this folder"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        HighlightBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                        Highlighter="{Binding DataContext.PathHighlighter, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Date modified" Binding="{Binding Modified, Converter={StaticResource DateTimeConverter}}" Width="130" SortMemberPath="Modified" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn x:Name="CreatedColumn" Header="Date created" Binding="{Binding Created, Converter={StaticResource DateTimeConverter}}" Width="130" SortMemberPath="Created" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="70" SortMemberPath="Extension" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Attributes" Binding="{Binding AttributesText}" Width="80" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" CanUserSort="False" />
                    <DataGridTextColumn x:Name="FullPathColumn" Header="Full path" Binding="{Binding FullPath}" Width="3*" SortMemberPath="Path" Visibility="Collapsed" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" MaxWidth="420">
                <TextBlock x:Name="EmptyGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="36" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding EmptyText}" FontSize="15" Margin="0,10,0,2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Shown while files are dragged over the pane: where they will land and whether they are copied or moved -->
            <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                    CornerRadius="8" Padding="14,7" Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock x:Name="DropHintText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
        </Grid>

        <!-- Pane status -->
        <DockPanel Grid.Row="5" Margin="4,5,4,6">
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="12,0,0,0" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
