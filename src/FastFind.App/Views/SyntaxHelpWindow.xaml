<Window x:Class="FastFind.App.Views.SyntaxHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcuts and search syntax" Width="700" Height="760" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Code" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3,16,3" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,20">
        <StackPanel>
            <TextBlock Style="{StaticResource H}" Text="Getting around" Margin="0,6,0,6" />
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource Code}">
                        <Setter Property="Width" Value="210" />
                    </Style>
                </StackPanel.Resources>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Enter  /  Backspace" /><TextBlock Style="{StaticResource Desc}" Text="Open the selected folder or file  /  go up to the containing folder." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Alt+Left  Alt+Right  Alt+Up" /><TextBlock Style="{StaticResource Desc}" Text="Back, forward, up. The extra mouse buttons also go back and forward." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+L  or  Alt+D" /><TextBlock Style="{StaticResource Desc}" Text="Type a path in the address bar. %TEMP% and ~ work; text that is not a path searches everywhere." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+P" /><TextBlock Style="{StaticResource Desc}" Text="Jump to any folder on any indexed drive by typing part of its name." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+F  (or just type)" /><TextBlock Style="{StaticResource Desc}" Text="Filter the folder on show. Esc clears the filter." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+Shift+R" /><TextBlock Style="{StaticResource Desc}" Text="Include subfolders: the folder and everything beneath it as one flat, sortable list." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+Shift+F" /><TextBlock Style="{StaticResource Desc}" Text="Search everywhere (every indexed drive). The global hotkey does the same from any program." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+T  Ctrl+W  Ctrl+Shift+T" /><TextBlock Style="{StaticResource Desc}" Text="New tab at the same folder, close tab, reopen the last closed tab. Ctrl+Tab and Ctrl+1…9 switch tabs; middle-click closes one." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+\  Tab" /><TextBlock Style="{StaticResource Desc}" Text="One pane or two side by side  /  move between the panes." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+B  Alt+P" /><TextBlock Style="{StaticResource Desc}" Text="Show or hide the sidebar  /  the preview pane." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+R  (F5)" /><TextBlock Style="{StaticResource Desc}" Text="Refresh. Folders also refresh on their own when something changes." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+H" /><TextBlock Style="{StaticResource Desc}" Text="Show or hide hidden and system items in this tab." /></DockPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource H}" Text="Working with files" />
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource Code}">
                        <Setter Property="Width" Value="210" />
                    </Style>
                </StackPanel.Resources>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="F5  /  F6" /><TextBlock Style="{StaticResource Desc}" Text="Copy / move the selection to the folder shown in the other pane (asks first)." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+C  Ctrl+X  Ctrl+V" /><TextBlock Style="{StaticResource Desc}" Text="Copy, cut and paste: works with Explorer and other programs too. Drag and drop moves within a drive and copies between drives; hold Ctrl to copy or Shift to move." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+Shift+N (F7)  Ctrl+N" /><TextBlock Style="{StaticResource Desc}" Text="New folder  /  new file." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="F2  Ctrl+F2" /><TextBlock Style="{StaticResource Desc}" Text="Rename  /  rename several items with find and replace, numbering and case changes." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Del  Shift+Del" /><TextBlock Style="{StaticResource Desc}" Text="Send to the Recycle Bin  /  delete permanently." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+Shift+C" /><TextBlock Style="{StaticResource Desc}" Text="Copy the full path of the selection (or of the folder when nothing is selected)." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+A  Ctrl+I" /><TextBlock Style="{StaticResource Desc}" Text="Select everything  /  invert the selection." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Alt+Enter" /><TextBlock Style="{StaticResource Desc}" Text="Properties." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Shift+Right-click" /><TextBlock Style="{StaticResource Desc}" Text="The full Windows menu (Send to, 7-Zip, Git and so on). It is also at the bottom of the normal right-click menu." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+S  Ctrl+Shift+S" /><TextBlock Style="{StaticResource Desc}" Text="Export the list  /  the selection as CSV, text or an Everything file list." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="foldersize:&gt;1gb" /><TextBlock Style="{StaticResource Desc}" Text="Find folders by their total size. Folder sizes come from the index, so sorting by Size shows where the space went." /></DockPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource H}" Text="Search basics" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Code}" Text="report budget" />
                <TextBlock Style="{StaticResource Desc}" Grid.Column="1" Text="Space means AND: names containing both words, in any order." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="1" Text="*.jpg|*.png" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="1" Grid.Column="1" Text="| means OR. OR binds tighter than AND, so  photo *.jpg|*.png  = photo AND (jpg OR png)." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="2" Text="!backup" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="2" Grid.Column="1" Text="! excludes. Works before any term or function, e.g.  !ext:tmp" />
                <TextBlock Style="{StaticResource Code}" Grid.Row="3" Text="&quot;final draft&quot;" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="3" Grid.Column="1" Text="Quotes keep spaces inside one term." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="4" Text="inv*2024.pdf   ?.txt" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="4" Grid.Column="1" Text="* matches any run of characters, ? exactly one. A wildcard term must match the whole name." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="5" Text="Aa  .*  W  Path" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="5" Grid.Column="1" Text="Match options in the filter panel: match case, regular expressions, whole word, and matching against the full path instead of the name." />
            </Grid>

            <TextBlock Style="{StaticResource H}" Text="Functions" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Code}" Grid.Row="0" Text="ext:pdf;docx" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="0" Grid.Column="1" Text="File extension (separate several with ; or ,)." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="1" Text="size:&gt;10mb   size:1mb..5mb" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="1" Grid.Column="1" Text="Size: &gt; &lt; &gt;= &lt;= = or a range. Units kb mb gb tb. Also  size:empty tiny small medium large huge gigantic." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="2" Text="dm:today   dm:last7days" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="2" Grid.Column="1" Text="Date modified: today, yesterday, thisweek, lastweek, thismonth, lastmonth, thisyear, lastyear, lastNdays/weeks/months/years/hours." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="3" Text="dm:2024   dm:2024-05   dm:&gt;2024-05-01" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="3" Grid.Column="1" Text="A year, a month, a day, comparisons, or a range  dm:2024-01-01..2024-03-31." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="4" Text="dc:thisweek" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="4" Grid.Column="1" Text="Date created, same syntax as dm:." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="5" Text="path:source\FastFind" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="5" Grid.Column="1" Text="Match text anywhere in the full path." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="6" Text="infolder:C:\Users\joe" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="6" Grid.Column="1" Text="Only results under that folder (recursive). parent: limits to the folder itself." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="7" Text="folder:   file:" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="7" Grid.Column="1" Text="Only folders / only files. folder:build limits the name match to folders." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="8" Text="type:images" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="8" Grid.Column="1" Text="Kinds: documents, images, audio, video, archives, executables, code." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="9" Text="regex:^inv_\d{4}" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="9" Grid.Column="1" Text=".NET regular expression on the name." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="10" Text="case:README   wfn:notes.txt" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="10" Grid.Column="1" Text="case: forces case sensitivity for that term. wfn: matches the whole file name exactly." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="11" Text="attrib:h   empty:" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="11" Grid.Column="1" Text="Attributes h s r a c e l t. empty: finds zero-byte files." />
                <TextBlock Style="{StaticResource Code}" Grid.Row="12" Text="ext:log size:&gt;50mb dm:lastweek" />
                <TextBlock Style="{StaticResource Desc}" Grid.Row="12" Grid.Column="1" Text="Combine freely. The filter panel adds the same constraints without typing." />
            </Grid>

            <TextBlock Style="{StaticResource H}" Text="Also useful" />
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource Code}">
                        <Setter Property="Width" Value="210" />
                    </Style>
                </StackPanel.Resources>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+Alt+F (global)" /><TextBlock Style="{StaticResource Desc}" Text="Show or hide FastFind from anywhere. Change it in Settings. Closing the window keeps FastFind in the tray; Ctrl+Q exits." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Ctrl+Shift+E" /><TextBlock Style="{StaticResource Desc}" Text="Show the selected item in Windows Explorer." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Column headers" /><TextBlock Style="{StaticResource Desc}" Text="Click to sort; right-click to choose columns. Drag the line between the panes to resize them, double-click it to make them equal." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="Sidebar" /><TextBlock Style="{StaticResource Desc}" Text="Click a place to open it, middle-click for a new tab, drop files on it to copy or move them there. Right-click a folder and choose Pin to sidebar to add your own." /></DockPanel>
                <DockPanel><TextBlock Style="{StaticResource Key}" Text="FastFind.exe C:\folder" /><TextBlock Style="{StaticResource Desc}" Text="Opens that folder in a new tab of the running window. Settings can add Open in FastFind to the Windows right-click menu." /></DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
