<Window x:Class="FastFind.App.Views.BulkRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename multiple items" Width="900" Height="640" WindowStartupLocation="CenterOwner" MinWidth="720" MinHeight="480"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="G" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,2,14,6" />
        </Style>
    </Window.Resources>
    <Grid Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border CornerRadius="8" Padding="14,10,14,6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <WrapPanel>
                <StackPanel Style="{StaticResource G}">
                    <TextBlock Style="{StaticResource L}" Text="FIND" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="160" TextChanged="OnOptionChanged" />
                        <CheckBox x:Name="RegexBox" Content="Regex" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                        <CheckBox x:Name="CaseBox" Content="Match case" Margin="8,0,0,0" VerticalAlignment="Center" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource G}">
                    <TextBlock Style="{StaticResource L}" Text="REPLACE WITH" />
                    <TextBox x:Name="ReplaceBox" Width="160" TextChanged="OnOptionChanged" ToolTip="With Regex on, use $1 $2 for groups" />
                </StackPanel>
                <StackPanel Style="{StaticResource G}">
                    <TextBlock Style="{StaticResource L}" Text="PREFIX" />
                    <TextBox x:Name="PrefixBox" Width="110" TextChanged="OnOptionChanged" />
                </StackPanel>
                <StackPanel Style="{StaticResource G}">
                    <TextBlock Style="{StaticResource L}" Text="SUFFIX" />
                    <TextBox x:Name="SuffixBox" Width="110" TextChanged="OnOptionChanged" ToolTip="Added before the extension" />
                </StackPanel>
                <StackPanel Style="{StaticResource G}">
                    <TextBlock Style="{StaticResource L}" Text="NUMBERING" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="NumberBox" Width="110" SelectionChanged="OnOptionChanged">
                            <ComboBoxItem Content="None" IsSelected="True" />
                            <ComboBoxItem Content="Prefix  1_name" />
                            <ComboBoxItem Content="Suffix  name_1" />
                            <ComboBoxItem Content="Replace name" />
                        </ComboBox>
                        <TextBlock Text="start" Margin="8,0,4,0" VerticalAlignment="Center" />
                        <TextBox x:Name="StartBox" Width="44" Text="1" TextChanged="OnOptionChanged" />
                        <TextBlock Text="digits" Margin="8,0,4,0" VerticalAlignment="Center" />
                        <TextBox x:Name="PadBox" Width="36" Text="1" TextChanged="OnOptionChanged" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource G}">
                    <TextBlock Style="{StaticResource L}" Text="CASE" />
                    <ComboBox x:Name="CaseModeBox" Width="110" SelectionChanged="OnOptionChanged">
                        <ComboBoxItem Content="Keep" IsSelected="True" />
                        <ComboBoxItem Content="lower case" />
                        <ComboBoxItem Content="UPPER CASE" />
                        <ComboBoxItem Content="Title Case" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Style="{StaticResource G}">
                    <TextBlock Style="{StaticResource L}" Text="EXTENSION" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ExtModeBox" Width="110" SelectionChanged="OnOptionChanged">
                            <ComboBoxItem Content="Keep" IsSelected="True" />
                            <ComboBoxItem Content="Change to" />
                            <ComboBoxItem Content="Include in find" />
                        </ComboBox>
                        <TextBox x:Name="ExtBox" Width="70" Margin="6,0,0,0" TextChanged="OnOptionChanged" ToolTip="New extension without the dot" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource G}" VerticalAlignment="Bottom">
                    <Button Content="Reset" Padding="10,4" Click="OnResetClick" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="PreviewGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="26" FontSize="13" BorderThickness="0" Background="Transparent"
                  VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Current name" Binding="{Binding OldName}" Width="*" />
                <DataGridTextColumn Header="New name" Binding="{Binding NewName}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUnchanged}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" Width="90" IsCancel="True" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Rename" Width="110" Margin="0,0,8,0" Click="OnApplyClick" IsDefault="True" />
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
    </Grid>
</Window>
