<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FastFind.App</RootNamespace>
    <AssemblyName>FastFind</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FastFind.Core\FastFind.Core.csproj" />
    <!-- Referenced only so the index service (exe, dll and runtime config) is copied beside the app; it runs as its own process. -->
    <ProjectReference Include="..\FastFind.Service\FastFind.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tray-resident app: prefer a smaller heap over a little GC throughput. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="6" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its namespace out of the implicit usings to avoid clashes with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
