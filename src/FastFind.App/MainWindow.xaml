<Window x:Class="FastFind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastFind.App.Views"
        Title="FastFind" MinWidth="760" MinHeight="480"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Opaque on purpose: over the transparent window backdrop, areas a hidden pane used to cover were left showing stale pixels -->
        <Grid x:Name="Body" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: places, pinned folders, drives -->
            <Border x:Name="SidebarHost" Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="8,10,8,8">
                    <ItemsControl ItemsSource="{Binding Sidebar}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="10,4,0,4"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SidebarButton}" Click="OnSidebarClick" PreviewMouseDown="OnSidebarMouseDown"
                                                        PreviewMouseRightButtonUp="OnSidebarRightClick" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Title}"
                                                        AllowDrop="True" DragOver="OnSidebarDragOver" Drop="OnSidebarDrop">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="15" VerticalAlignment="Center" Margin="0,0,11,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <Grid Height="4" Margin="0,4,0,1" Visibility="{Binding HasBar, Converter={StaticResource BoolToVisibility}}">
                                                                <Border CornerRadius="2" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" Opacity="0.5" />
                                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}" Height="4" BorderThickness="0" Background="Transparent" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding Detail}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       Visibility="{Binding HasBar, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" Margin="-2,0" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" />

            <views:PaneView x:Name="LeftPane" Grid.Column="2" DataContext="{Binding Left}" />

            <GridSplitter x:Name="PaneSplitter" Grid.Column="3" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" MouseDoubleClick="OnPaneSplitterDoubleClick" ToolTip="Drag to resize the panes; double-click to make them equal">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <views:PaneView x:Name="RightPane" Grid.Column="4" DataContext="{Binding Right}" />

            <GridSplitter x:Name="PreviewSplitter" Grid.Column="5" Width="5" Margin="-2,0" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" />
            <views:PreviewPane x:Name="Preview" Grid.Column="6" />
        </Grid>

        <!-- Status bar: the state of the index -->
        <Border Grid.Row="1" Padding="16,5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="90" Height="4" Margin="0,0,10,0" IsIndeterminate="True"
                                 Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding IndexStatus}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding IndexDetail}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="12,0,0,0" FontSize="12" Visibility="{Binding ServiceHintVisible, Converter={StaticResource BoolToVisibility}}">
                        <Hyperlink Click="OnEnableServiceClick" ToolTip="Installs a small background service (one administrator prompt) that reads the NTFS file table directly. Indexing drops from minutes to seconds, changes are picked up from the change journal, and this window keeps running without administrator rights.">Enable instant NTFS indexing</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="HintText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="F1 shortcuts  ·  Ctrl+P jump to folder  ·  Ctrl+Shift+F search everywhere  ·  F5 / F6 copy / move to the other pane" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
