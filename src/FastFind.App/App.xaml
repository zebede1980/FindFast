<Application x:Class="FastFind.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FastFind.App.Converters"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <conv:DateTimeConverter x:Key="DateTimeConverter" />
            <conv:LocalTimeConverter x:Key="LocalTimeConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:BoolToOpacityConverter x:Key="HiddenOpacity" />

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

            <!-- The glass look: translucent tints over the blurred desktop that shows through the main window. These are the
                 dark values, as a starting point; FrostTheme replaces them all at start-up and whenever the theme or the
                 Windows accent colour changes. -->
            <SolidColorBrush x:Key="FrostWindowTintBrush" Color="#A60A0C1C" />
            <SolidColorBrush x:Key="FrostWindowTintInactiveBrush" Color="#DB0C0E1A" />
            <!-- Pools of coloured light behind the panes, and the colour the active pane's edge glows in -->
            <SolidColorBrush x:Key="FrostGlowABrush" Color="Transparent" />
            <SolidColorBrush x:Key="FrostGlowBBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FrostGlowCBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FrostGlowDBrush" Color="Transparent" />
            <SolidColorBrush x:Key="FrostBrandBrush" Color="#FF60CDFF" />
            <Color x:Key="FrostAccentColor">#FF60CDFF</Color>
            <SolidColorBrush x:Key="FrostPaneBrush" Color="#73080A18" />
            <SolidColorBrush x:Key="FrostTextSecondaryBrush" Color="#E0FFFFFF" />
            <SolidColorBrush x:Key="FrostTextTertiaryBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="FrostCardBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="FrostCardStrokeBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="FrostFieldBrush" Color="#3D000000" />
            <SolidColorBrush x:Key="FrostFieldStrokeBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="FrostHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FrostPressedBrush" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="FrostTabSelectedBrush" Color="#21FFFFFF" />
            <SolidColorBrush x:Key="FrostDividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FrostActiveStrokeBrush" Color="#9960CDFF" />
            <!-- Selected rows in the file lists: a tint of the accent colour, so text keeps its normal colour and stays readable. -->
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#4060CDFF" />

            <!-- Icon button used in the title bar, the tab strip and the command bar -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource FrostTextSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The same button for something that is on or off (sidebar, second pane, preview): it stays lit while on -->
            <Style x:Key="IconToggle" TargetType="ToggleButton">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource FrostTextSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostTabSelectedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostPressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Glass toggle used beside the search box (lock, subfolders, filters) and for Aa / .* / W / Path -->
            <Style x:Key="PillToggle" TargetType="ToggleButton">
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{DynamicResource FrostCardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrostCardStrokeBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FrostTextSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostTabSelectedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The "Jump to any folder" box in the middle of the title bar: it looks like a search box and opens the jump list -->
            <Style x:Key="JumpPill" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Background" Value="{DynamicResource FrostFieldBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrostFieldStrokeBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FrostTextSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="13" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,0,8,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FrostActiveStrokeBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One segment of the address bar -->
            <Style x:Key="CrumbButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostPressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A place in the sidebar -->
            <Style x:Key="SidebarButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="9,5" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostPressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource FrostTextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,3" />
            </Style>

            <Style x:Key="FilterGroup" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,2,14,4" />
            </Style>

            <!-- Tab headers: a rounded chip that lights up when selected -->
            <Style x:Key="SearchTabItem" TargetType="TabItem">
                <Setter Property="Padding" Value="10,0,6,0" />
                <Setter Property="Margin" Value="0,0,4,2" />
                <Setter Property="Foreground" Value="{DynamicResource FrostTextSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" CornerRadius="8" Height="30" Background="Transparent" Padding="{TemplateBinding Padding}" MinWidth="90" MaxWidth="220"
                                    ToolTip="{Binding Location}">
                                <DockPanel>
                                    <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="9"
                                            Content="&#xE8BB;" Margin="6,0,0,0" Opacity="0" ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock x:Name="Glyph" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding TabGlyph}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" Opacity="0.8" />
                                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostHoverBrush}" />
                                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FrostTabSelectedBrush}" />
                                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SearchTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource SearchTabItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="8,8,8,0" LastChildFill="True">
                                    <!-- Space reserved for the new-tab button PaneView lays over the strip, just after the last tab. It lives
                                         outside this template because a tab control exposes only its tabs to assistive technology. -->
                                    <Border DockPanel.Dock="Right" Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <!-- The tab panel takes the remaining width so a crowded strip wraps onto a second row instead of clipping -->
                                    <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                                </DockPanel>
                                <!-- The part name matters: without it the tab's content is invisible to screen readers and UI automation -->
                                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
